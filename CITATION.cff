cff-version: 1.2.0
message: "If you use DOTE Whisper in academic work, please cite it using the metadata below, together with the upstream projects listed in `references`."
title: "DOTE Whisper"
abstract: >-
    DOTE Whisper is a desktop application for macOS and Windows that
    transcribes recorded audio with speaker diarization. It wraps
    whisper.cpp for speech recognition (with word-level timestamps and
    confidence scores) and sherpa-onnx for speaker diarization, and runs
    entirely on the user's own computer, without an account, API key or
    upload. It is designed for research recordings that cannot be sent
    to a cloud service.
type: software
authors:
    - family-names: Stein
      given-names: Alex
license-url: "https://github.com/LiminalSpaces/dote-whisper-dist/blob/main/LICENSE.md"
url: "https://dote-whisper.alexstein.ca"
repository-artifact: "https://github.com/LiminalSpaces/dote-whisper-dist/releases"
keywords:
    - transcription
    - speech-to-text
    - whisper
    - whisper.cpp
    - speaker-diarization
    - sherpa-onnx
    - on-device
    - privacy-preserving
    - qualitative-research
references:
    - type: software
      title: "whisper.cpp"
      authors:
          - family-names: Gerganov
            given-names: Georgi
      repository-code: "https://github.com/ggml-org/whisper.cpp"
      license: MIT
    - type: article
      title: "Robust Speech Recognition via Large-Scale Weak Supervision"
      authors:
          - family-names: Radford
            given-names: Alec
          - family-names: Kim
            given-names: Jong Wook
          - family-names: Xu
            given-names: Tao
          - family-names: Brockman
            given-names: Greg
          - family-names: McLeavey
            given-names: Christine
          - family-names: Sutskever
            given-names: Ilya
      year: 2022
      url: "https://arxiv.org/abs/2212.04356"
    - type: software
      title: "sherpa-onnx"
      authors:
          - name: "The k2-fsa project"
      repository-code: "https://github.com/k2-fsa/sherpa-onnx"
      license: Apache-2.0
